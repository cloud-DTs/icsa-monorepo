# On Linux, set these to the output of `id -u` and `id -g`.
# Docker Desktop users can normally keep the defaults.
DTP_UID=1000
DTP_GID=1000

MODEL_FILE=model.xml
TWIN_NAME=dtwin

PIPELINE_INPUT_HOST_DIR=./pipeline/digital-twin-profile-sysml-v1/input
PIPELINE_OUTPUT_HOST_DIR=./pipeline/digital-twin-profile-sysml-v1/output
PIPELINE_CODE_HOST_DIR=./demo-code

# Format: source-prefix=container-prefix. Separate multiple mappings with `;`.
# Example for an Enterprise Architect model containing Windows paths:
# DTP_PATH_MAP=C:/work/strategy-code=/pipeline/code
DTP_PATH_MAP=
