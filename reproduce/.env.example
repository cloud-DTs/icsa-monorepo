# Copy to .env and fill in. .env is ignored by Git.

# AWS access of the deployer and the evaluator
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

DOCKER_DEFAULT_PLATFORM=linux/amd64

# Case study CS1: charging point station. Managed Grafana belongs to this twin.
TWIN=MGridICSA
DEPLOY_MANAGED_GRAFANA=true

# Case study CS2: virtual power plant
# TWIN=VPP
# DEPLOY_MANAGED_GRAFANA=false
