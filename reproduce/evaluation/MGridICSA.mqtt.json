{
  "schema_version": 1,
  "evaluation": "mqtt",
  "parameters": {
    "target": "MicroGrid.charger1.p13",
    "property": "power",
    "value_range": [1.0, 2.0],
    "feedback_action": "balance1",
    "response_value_path": ["inputs", "charger1Power"],
    "response_match": {"action": "balance1"},
    "samples": 100,
    "warmup": 10,
    "concurrency": 1,
    "timeout_seconds": 10,
    "setup_timeout_seconds": 10
  }
}
